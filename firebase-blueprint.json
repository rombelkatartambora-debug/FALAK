  "firestore": {
    "/students/{studentId}": {
      "schema": "Student",
      "description": "Collection of all students and Buku Induk profiles"
    },
    "/schedules/{scheduleId}": {
      "schema": "ExamSchedule",
      "description": "Collection of exam schedules"
    },
    "/questions/{questionId}": {
      "schema": "Question",
      "description": "Collection of CBT questions"
    },
    "/submissions/{submissionId}": {
      "schema": "Submission",
      "description": "Collection of student exam submissions and grades"
    },
    "/users/{userId}": {
      "schema": "SystemUser",
      "description": "Collection of user accounts"
    },
    "/logs/{logId}": {
      "schema": "SystemLog",
      "description": "Audit and anti-cheat violation logs"
    }
  }
